{
    "name": "pyhst/gpl",
    "description": "Payment gateway API connector libraries",
    "keywords": [
        "bank",
        "payment-gateway",
        "payment-processing",
        "payment-vendor",
        "qris",
        "api"
    ],
    "homepage": "https://payhost.io/",
    "type": "library",
    "authors": [{
			"name": "Payhost",
			"email": "it@payhost.io"
    }],
    "require": {
        "php": "^8.0",
        "symfony/dotenv": "^5.4",
        "guzzlehttp/guzzle": "^7.8",
        "nesbot/carbon": "^2.72.6",
        "chillerlan/php-qrcode": "^5.0",
        "monolog/monolog": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PyGPaymentLib\\": "src/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
